# ===== Python 运行时产物 =====
__pycache__/
*.py[cod]
*$py.class
*.pyd
*.so

# ===== 虚拟环境（.venv 体积大，勿提交）=====
.venv/
venv/
env/
ENV/
.conda/

# ===== PyInstaller 打包产物 =====
