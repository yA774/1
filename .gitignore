build/
dist/
*.spec
_internal/
*.exe
*.manifest

# ===== 测试与静态检查缓存 =====
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyre/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/

# ===== IDE / 编辑器（PyCharm、VS Code）=====
.idea/
.vscode/
*.iml
*.swp
*.swo

# ===== 系统文件 =====
Thumbs.db
desktop.ini
.DS_Store

# ===== 本地导出 / 临时文件（examples、docs 需保留，故只忽略目录）=====
/导出/
/exports/
/output/
/临时/
*.log
*.tmp
*.bak
~$*.docx
~$*.pdf